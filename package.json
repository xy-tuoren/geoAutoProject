{
  "name": "question-automation-electron",
  "version": "0.1.7",
  "private": true,
  "description": "Cross-platform Electron operator panel for ADB question automation.",
  "repository": {
    "type": "git",
    "url": "https://github.com/xy-tuoren/geoAutoProject.git"
  },
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-syntax.js",
    "test": "node --test tests/node/**/*.test.js",
    "run:android": "node src/cli.js",
    "clean": "node scripts/clean-generated.js",
    "clean:all": "node scripts/clean-generated.js --include-captures",
    "setup": "npm install && npm run prepare:runtime",
    "prepare:u2": "node scripts/build-u2-runtime.js",
    "prepare:scrcpy": "node scripts/prepare-scrcpy.js",
    "prepare:runtime": "node scripts/prepare-runtime.js && npm run prepare:u2 && npm run prepare:scrcpy",
    "dist": "npm run prepare:runtime && electron-builder"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "electron-updater": "^6.8.9",
    "sharp": "^0.35.3",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.xiaohe.questionautomation",
    "productName": "geo数据采集",
    "asar": false,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/platform-tools/darwin",
        "to": "vendor/platform-tools/darwin"
      },
      {
        "from": "vendor/platform-tools/win32",
        "to": "vendor/platform-tools/win32"
      },
      {
        "from": "vendor/u2-runtime",
        "to": "vendor/u2-runtime"
      },
      {
        "from": "vendor/scrcpy",
        "to": "vendor/scrcpy"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "${name}-setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "http://104.168.30.172/geo-updates/win/"
      }
    ]
  }
}
